APP_NAME=Poker App
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Public project entrypoint.
PUBLIC_BASE_URL=https://poker-u-molodogo.dimension-x.dedyn.io
CORS_ALLOWED_ORIGINS=https://poker-u-molodogo.dimension-x.dedyn.io,http://localhost:5173

# Bot / webhook secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

VK_GROUP_TOKEN=
VK_CONFIRMATION_TOKEN=
VK_SECRET_KEY=
VK_API_VERSION=5.199

# Leave empty to use data/poker_app.db from the standard project structure.
DATABASE_URL=

# Optional path overrides. In the standard /opt/apps/poker-u-molodogo layout
# these values can stay commented out.
# DATA_DIR=../data
# LOGS_DIR=../logs
# STATIC_DIR=../data/static
# USER_PHOTOS_DIR=../data/static/user_photos
# WEBAPP_DIST_DIR=../webapp/dist
# SITE_DIST_DIR=../site/dist

GOOGLE_BACKUP_ENABLED=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_CREDENTIALS_PATH=../credentials.json
